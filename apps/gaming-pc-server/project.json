{
  "name": "gaming-pc-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "check": {
      "command": "make check",
      "options": { "cwd": "{projectRoot}" }
    },
    "build-wsl": {
      "command": "make build-wsl",
      "options": { "cwd": "{projectRoot}" }
    },
    "test": {
      "command": "make test",
      "options": { "cwd": "{projectRoot}", "tty": true }
    },
    "ssh-windows": {
      "command": "ssh jcgla@josh-desktop"
    },
    "ssh": {
      "command": "ssh nixos@gaming-pc-server"
    },
    "ssh-test": {
      "command": "make ssh-test",
      "options": { "cwd": "{projectRoot}", "tty": true }
    },
    "copy-to-pc": {
      "command": "make copy-to-pc",
      "options": { "cwd": "{projectRoot}" }
    },
    "deploy": {
      "command": "make deploy",
      "options": { "cwd": "{projectRoot}", "tty": true }
    },
    "secrets": {
      "command": "make secrets",
      "options": { "cwd": "{projectRoot}", "tty": true }
    },
    "update": {
      "command": "make update",
      "options": { "cwd": "{projectRoot}" }
    },
    "clean": {
      "command": "make clean",
      "options": { "cwd": "{projectRoot}" }
    }
  }
}
